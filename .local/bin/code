#!/usr/bin/env bash

if [ -z "${1}" ]; then
    path=$(realpath $(pwd))
else
    path=$(realpath "${1}")
fi

if [[ -d $path ]]; then
    dir=$path
else
    dir=$(dirname "$path")
fi

if root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null); then
    ws=("$root"/*.code-workspace)
    if [[ ${#ws[@]} -eq 1 && -f ${ws[0]} ]]; then
        >&2 echo "Opening VS Code workspace ${ws[0]}"
        if [[ $path == "${ws[0]}" || -d $path ]]; then
            exec /usr/bin/code "${ws[0]}"
        fi
        exec /usr/bin/code "${ws[0]}" "$path"
    fi
    >&2 echo "Opening git repo ${root}"
    exec /usr/bin/code "$root" "$path"
else
    exec /usr/bin/code "$dir" "$path"
fi
