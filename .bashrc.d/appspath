# Nested shells inherit PATH, so every entry has to be added at most once.
__path_append () {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$PATH:$1" ;;
    esac
}

if [ -d ~/Applications ]; then
    while IFS= read -r -d '' dir; do
        __path_append "$dir"
    done < <(find ~/Applications -maxdepth 4 -type d -name bin -print0)
    unset dir
fi

__path_append "$HOME/.cargo/bin"
